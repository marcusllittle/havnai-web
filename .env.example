# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Base URL for the havnai-core API (must be HTTPS in production)
NEXT_PUBLIC_HAVNAI_API_BASE=https://api.joinhavn.io

# EVM wallet addresses (replace with your own)
NEXT_PUBLIC_HAVNAI_WALLET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HAI_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HAI_TREASURY_WALLET=0x0000000000000000000000000000000000000000

# Chain IDs
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=0xaa36a7
